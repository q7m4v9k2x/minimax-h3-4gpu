# Copy to a private .env file or export in the shell. Do not commit secrets.
COMFYUI_DIR=/home/ymzx/ComfyUI
# Physical IDs on the target workstation. GPU 0 is a Quadro K620 and is excluded.
GPU_IDS=1,2,3,4
H3_TASK=fl2va
H3_MODEL_DIR=/data/models/MiniMax-H3
H3_WORK_DIR=/data/minimax-h3-runs
# Keep V100 on CUDA 12.x-compatible kernels.
CUDA_DEVICE_ORDER=PCI_BUS_ID
NCCL_P2P_LEVEL=NVL
NCCL_IB_DISABLE=1
NCCL_ASYNC_ERROR_HANDLING=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# dg1kjd plugin options, only when that plugin is intentionally enabled.
COMFY_MINIMAX_SP_POOL=1
COMFY_MINIMAX_SP_FP16_ATTN=1
COMFY_MINIMAX_SP_FP16_COMM=1
